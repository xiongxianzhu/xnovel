# 复制为 .env 后按需修改；不要提交 .env 到版本库
APP_ENV=development

# 必填：生产环境使用至少 32 字节的随机强密钥
SECRET_KEY=replace-with-at-least-32-random-bytes

# 异步 PostgreSQL（测试可用 sqlite+aiosqlite:///:memory:）
# 格式：postgresql+asyncpg://用户名:密码@主机:端口/数据库名
# 例如本地 PostgreSQL 默认可填：
#   用户名：postgres
#   密码：postgres
#   数据库名：xnovel
# 如果密码为空，也可以写成：postgresql+asyncpg://postgres@localhost:5432/xnovel
# 或者显式写成：postgresql+asyncpg://postgres:@localhost:5432/xnovel
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/xnovel

# Web Access Token 与 Refresh Token
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
JWT_ISSUER=xnovel-api
JWT_AUDIENCE=xnovel-web
REFRESH_COOKIE_NAME=xnovel_refresh_token
REFRESH_COOKIE_SECURE=false

# JSON 数组；生产环境只填写实际 HTTPS Web 来源
TRUSTED_WEB_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# 头像和 Web 全局 Logo 的持久化目录
MEDIA_ROOT=./data/media

# Web Skill 不可变版本和归档存储目录
SKILL_STORAGE_ROOT=./data/skills

# Web AI 凭据主密钥：Base64 编码的 32 字节随机值；生产环境启用 AI 前必填
XNOVEL_CREDENTIAL_MASTER_KEY=
CREDENTIAL_MASTER_KEY_VERSION=v1

# 额外允许的自定义 Provider Origin；公网 HTTPS 不需要列入
PROVIDER_ALLOWED_ORIGINS=[]
AI_CALL_TIMEOUT_SECONDS=120
AI_MAX_CONCURRENCY_PER_USER=2
