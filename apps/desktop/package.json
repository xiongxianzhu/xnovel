{
  "name": "@xnovel/desktop",
  "version": "0.1.0",
  "description": "离线优先、作者掌控正文的开源小说工作室桌面端",
  "author": "xnovel contributors",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite src/renderer --host 127.0.0.1",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "pack:dir": "pnpm build && electron-builder --dir",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "dist:mac:x64": "pnpm build && electron-builder --mac dmg zip --x64",
    "dist:mac:arm64": "pnpm build && electron-builder --mac dmg zip --arm64",
    "release:win": "electron-builder --win nsis --x64 --publish always",
    "release:mac:x64": "electron-builder --mac dmg zip --x64 --publish always",
    "release:mac:arm64": "electron-builder --mac dmg zip --arm64 --publish always",
    "verify:win": "electron-builder --win nsis --x64 --publish never",
    "verify:mac:x64": "electron-builder --mac dmg zip --x64 --publish never",
    "verify:mac:arm64": "electron-builder --mac dmg zip --arm64 --publish never"
  },
  "dependencies": {
    "@xnovel/theme": "link:../../packages/theme",
    "electron-updater": "6.8.9",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.7",
    "electron-vite": "5.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "org.xnovel.desktop",
    "productName": "xnovel",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "resources/icon.svg",
      "target": [
        "nsis"
      ],
      "artifactName": "xnovel-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "resources/icon.svg",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "xnovel-${version}-macos-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "afterSign": "scripts/notarize.cjs",
    "publish": {
      "provider": "github",
      "owner": "xiongxianzhu",
      "repo": "xnovel",
      "releaseType": "release"
    }
  }
}
